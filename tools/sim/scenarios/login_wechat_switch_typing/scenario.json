   },
   "snap": "prompt"
  },
  {
   "send": "t"
  },
  {
   "wait_for": {
    "text": "Type the credentials directly",
    "timeout_ms": 15000
   },
   "snap": "type"
  },
  {
   "key": "Enter"
  },
  {
   "wait_ms": 300,
   "snap": "token_prompt"
  },
  {
   "send": "dshtypedtoken1234567890abcdef"
  },
  {
   "key": "Enter"
  },
  {
   "wait_for": {
    "text": "Logged in",
    "timeout_ms": 15000
   },
   "snap": "done"
  }
 ]
}