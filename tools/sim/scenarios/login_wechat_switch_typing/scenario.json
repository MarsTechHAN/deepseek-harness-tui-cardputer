{
 "mock_login": true,
 "env": {
  "MOCK_LOGIN_EXPIRED_N": "2"
 },
 "steps": [
  {
   "wait_for": {
    "text": "dst",
    "timeout_ms": 10000
   }
  },
  {
   "send": "/login"
  },
  {
   "key": "Enter"
  },
  {
   "wait_for": {
    "text": "Sign in to DeepSeek",
    "timeout_ms": 12000
   }
  },
  {
   "key": "Enter"
  },
  {
