  {"wait_for": {"text": "update channel set to stable", "timeout_ms": 8000}},
  {"wait_for": {"text": "update failed", "timeout_ms": 8000}},
  {"wait_ms": 200, "snap": "stable"},
  {"send": "/update bogus"}, {"key": "Enter"},
  {"wait_for": {"text": "usage: /update", "timeout_ms": 5000}},
  {"wait_ms": 200, "snap": "usage"}
 ]
